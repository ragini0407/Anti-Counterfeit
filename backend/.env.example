# =============================================================================
# Fake Product Detection - Backend Environment Configuration Template
# All values below are nonfunctional placeholders for deployment configuration.
# Inject genuine values at deployment time using your platform secrets manager.
# =============================================================================

PORT=5000
NODE_ENV=development

# Allowed Frontend Origin(s) for CORS (comma-separated if multiple)
# Required in production. Wildcard '*' is forbidden.
FRONTEND_ORIGIN=http://localhost:5173

# Reverse Proxy Trust Configuration (1 = single hop, false = direct, or IP list)
# Avoid blind trust: 'true' is safely interpreted as 1.
TRUST_PROXY=1

# MongoDB Connection String
MONGO_URI=mongodb+srv://PLACEHOLDER_USER:PLACEHOLDER_PASSWORD@cluster0.example.mongodb.net/anti_counterfeit?retryWrites=true&w=majority

# JWT Token Secret
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET_AT_LEAST_32_CHARS

# Ethereum Sepolia Testnet (V1 Read-Only Verification)
CHAIN_ID=11155111
BLOCKCHAIN_RPC_URL=https://rpc2.sepolia.org
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# AI Microservice (Optional)
AI_ENABLED=false
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=REPLACE_WITH_A_RANDOM_32_CHAR_TOKEN_IF_AI_IS_ENABLED
